{
  "extends": "@charva/config/tsconfig/react.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": ["@testing-library/jest-dom/vitest", "vite/client"]
  }
}
