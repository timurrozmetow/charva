# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
storybook-static/
*.tsbuildinfo

# turbo
.turbo/

# env — never commit real secrets
.env
.env.*
!.env.example
!.env.production.example

# uploads and generated media — the media store is local disk (D-8),
# so this directory is real data and must be in the backup, never in git
uploads/
apps/api/uploads/

# database dumps and backups
*.sql
*.sql.gz
*.dump
backups/

# ...but never the migrations, which are source code and the only definition
# of the schema. `*.sql` above was written for dumps and quietly swallowed
# them: a clean clone had `meta/_journal.json` listing two migrations and no
# files to apply, so `pnpm db:migrate` succeeded against an empty database.
!apps/api/src/db/migrations/*.sql

# local portable dev services (mysql, mailpit, ffmpeg)
.services/

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# misc
.eslintcache
.cache/
tmp/

# Agent skills installed with `npx skills add` — third-party guidance, not this project's code.
# Kept out of the repository for the same reason node_modules is: it is fetched, not written,
# and `skills-lock.json` is the record of what was fetched.
.agents/
.claude/
skills-lock.json
