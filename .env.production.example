# ======================================================================================
# Charva Travel — production environment
#
# Copy to the server as /opt/charva/shared/.env, fill in, and never commit the result.
# It is symlinked into each release, so a deploy never rewrites it and a rollback never
# reverts it: secrets and the database password outlive the code that reads them.
#
# Five secrets below have development defaults that `loadEnv` REFUSES under
# NODE_ENV=production. A half-configured deploy therefore fails at boot, loudly, instead of
# running with a signing key that is printed in a public repository.
#
#   for i in 1 2 3 4; do node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"; done
# ======================================================================================

NODE_ENV=production
LOG_LEVEL=info

# --------------------------------------------------------------------------------------
# API
#
# Bound to the loopback, not to 0.0.0.0. nginx is the only thing that should be able to
# reach the API: bound publicly, port 3002 answers the same requests without the rate
# limits, the TLS and the header policy that live in the proxy in front of it.
# --------------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3002

# The four public origins. Never `*` — the admin host sends a session cookie, and a
# wildcard with credentials is the one combination browsers refuse outright.
CORS_ORIGINS=https://charva-travel.com,https://global.charva-travel.com,https://umra.charva-travel.com,https://admin.charva-travel.com

# --------------------------------------------------------------------------------------
# Database
#
# A dedicated account, not root. It needs no GRANT beyond the `charva` schema, and giving
# it none is what stops an SQL injection that reaches the driver from reading the other
# databases on the machine.
# --------------------------------------------------------------------------------------
DATABASE_URL=mysql://charva:CHANGE-ME@127.0.0.1:3306/charva
DATABASE_NAME_PREFIX=charva
DATABASE_POOL_SIZE=10

# --------------------------------------------------------------------------------------
# Media
#
# An absolute path outside the release directory. `uploads/` is real data — the only copy
# of every photograph — and a relative path would put it inside a release that the next
# deploy replaces and `rollback.sh` deletes. Decision D-8, risk R-7.
# --------------------------------------------------------------------------------------
UPLOADS_DIR=/opt/charva/shared/uploads

# Absolute, so a URL copied out of a JSON response into an OG tag still resolves.
PUBLIC_MEDIA_BASE_URL=https://api.charva-travel.com

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

MAX_IMAGE_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=400

# --------------------------------------------------------------------------------------
# The SPA shell
#
# nginx sends HTML requests to /api/v1/shell, which reads the built index.html of that site
# and renders the head into it (D-4). Absolute here: the API's working directory under PM2
# is the release, and the relative default resolves against it correctly, but an absolute
# path survives someone changing `cwd` in the ecosystem file.
# --------------------------------------------------------------------------------------
SHELL_DIST_DIR=/opt/charva/current/apps

# --------------------------------------------------------------------------------------
# Cache and rate limits
#
# The API runs as a single PM2 fork (D-7). Both the cache and the limiters live in the
# process, so cluster mode would multiply every number below by the number of workers.
# --------------------------------------------------------------------------------------
CACHE_TTL_SECONDS=60
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MINUTES=10
READ_RATE_LIMIT_MAX=300

# --------------------------------------------------------------------------------------
# Admin sessions
# --------------------------------------------------------------------------------------
ADMIN_ACCESS_TTL_MINUTES=15
ADMIN_REFRESH_TTL_DAYS=30
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# --------------------------------------------------------------------------------------
# Secrets — all five must be replaced, and the API refuses to boot otherwise
#
# PASSPORT_ENCRYPTION_KEY is the one that cannot be rotated casually: it decrypts every
# passport number already stored (D-18). Losing it loses those rows; changing it makes them
# unreadable. Keep it wherever the database password is kept, and back both up together.
# --------------------------------------------------------------------------------------
FORM_TOKEN_SECRET=replace-me-with-32-random-bytes
IP_HASH_SECRET=replace-me-with-32-random-bytes
PASSPORT_ENCRYPTION_KEY=replace-me-64-hex-characters-0000000000000000000000000000000000
ADMIN_JWT_SECRET=replace-me-with-32-random-bytes
ADMIN_REFRESH_SECRET=replace-me-with-32-random-bytes

# --------------------------------------------------------------------------------------
# Notification of a filled-in form — question Q-11, answered 2026-08-23: SMTP
#
# All four or none. `createMailer` turns itself off unless it has host, user, password and a
# destination, because a half-configured mailer throws on every submission and reads as a
# broken form. Nothing depends on it: the enquiry is in the database and in the panel either
# way (D-50), and a rejection by the relay is logged and goes no further.
#
# `SMTP_SECURE` is nodemailer's name for «TLS from the first byte», which is port 465. Port 587
# is STARTTLS and wants `false` — it does not mean «unencrypted», which is what it looks like.
#
# The password for a Gmail account is an app password, not the account password, and Google
# prints it in four groups of four. The spaces are presentation and are stripped before use, so
# it can be pasted exactly as shown.
# --------------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=replace-me@gmail.com
EMAIL_PASS=replace-me-app-password
NOTIFICATION_EMAIL=replace-me@example.com
