# ======================================================================================
# Charva Travel — local development environment
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
# Values below match what `pnpm setup:services` provisions under .services/.
#
# This file grows one phase at a time: a variable appears here when code starts reading it,
# not before. Database settings arrive in Phase 2, mail and media in Phase 3, auth in Phase 7.
# ======================================================================================

# --------------------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --------------------------------------------------------------------------------------
# API
#
# Port 3002, not the usual 3001: the silkgrain project on this machine already owns 3001.
# The whole Charva port map lives in CLAUDE.md.
# --------------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3002

# Comma-separated origin allowlist. Never "*": the admin host sends a session cookie.
# Ports match the four Vite dev servers — choice, global, umrah, admin.
CORS_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183
