# ======================================================================================
# Charva Travel — local development environment
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
# Values below match what `pnpm setup:services` provisions under .services/.
#
# This file grows one phase at a time: a variable appears here when code starts reading it,
# not before. Database settings arrive in Phase 2, mail and media in Phase 3, auth in Phase 7.
# ======================================================================================

# --------------------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --------------------------------------------------------------------------------------
# API
#
# Port 3002, not the usual 3001: the silkgrain project on this machine already owns 3001.
# The whole Charva port map lives in CLAUDE.md.
# --------------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3002

# Comma-separated origin allowlist. Never "*": the admin host sends a session cookie.
# Ports match the four Vite dev servers — choice, global, umrah, admin.
CORS_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183

# --------------------------------------------------------------------------------------
# Database
#
# MySQL 8 on 3308 — not 3306, which XAMPP holds, and not 3307, which silkgrain holds.
# `pnpm setup:services` provisions it under .services/ with exactly this password, which is
# local-only and matches nothing else on this machine.
# --------------------------------------------------------------------------------------
DATABASE_URL=mysql://root:charva_dev_only@127.0.0.1:3308/charva

# The prefix `db:reset` checks before it drops anything. Seven other schemas live on this
# machine and belong to three other projects.
DATABASE_NAME_PREFIX=charva
DATABASE_POOL_SIZE=10

# Used by the database tests, which run against a real server rather than a mock.
TEST_DATABASE_URL=mysql://root:charva_dev_only@127.0.0.1:3308/charva_test


# --------------------------------------------------------------------------------------
# Media
#
# `media.storage_key` holds a key relative to UPLOADS_DIR, never a URL — decision D-8, so
# moving to object storage later replaces one adapter. PUBLIC_MEDIA_BASE_URL is empty in
# development, which means "same origin as the API"; in production it is the API host, so a
# URL copied out of a response into an OG tag still resolves.
# --------------------------------------------------------------------------------------
UPLOADS_DIR=uploads
PUBLIC_MEDIA_BASE_URL=

# --------------------------------------------------------------------------------------
# Cache and rate limits
#
# The cache is in-process and the API runs as a single PM2 fork — decision D-7. Cluster mode
# would multiply every limit below by the number of workers.
# --------------------------------------------------------------------------------------
CACHE_TTL_SECONDS=60

# Anti-spam layer one: five submissions per address per ten minutes.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MINUTES=10

# Reads. Generous on purpose: it exists to stop a scraper, not a visitor.
READ_RATE_LIMIT_MAX=300

# --------------------------------------------------------------------------------------
# Admin sessions
#
# Two tokens with different jobs. The access token is a JWT the SPA holds in a variable for
# fifteen minutes and never writes to storage; the refresh token is 48 random bytes in a
# HttpOnly cookie, rotated on every use, and stored only as an HMAC digest — so a dump of
# `admin_refresh_tokens` is not a set of working sessions.
#
# The lock is per account, the rate limit is per address: one stops a password being guessed,
# the other stops one address working through a list of accounts.
# --------------------------------------------------------------------------------------
ADMIN_ACCESS_TTL_MINUTES=15
ADMIN_REFRESH_TTL_DAYS=30
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# --------------------------------------------------------------------------------------
# Secrets
#
# All five have development defaults, so nothing has to be configured to run this locally.
# All five are REFUSED in production if left at that default — see loadEnv().
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------------------------

# Signs the moment a form was rendered, so the time trap needs no session and no table.
FORM_TOKEN_SECRET=replace-me-with-32-random-bytes

# Pepper for hashed IP addresses. Without it a SHA-256 of an IPv4 is a four-billion-row lookup.
IP_HASH_SECRET=replace-me-with-32-random-bytes

# AES-256-GCM for passport numbers — decision D-18. Exactly 32 bytes as 64 hex characters.
PASSPORT_ENCRYPTION_KEY=replace-me-64-hex-characters-0000000000000000000000000000000000

# Signs the admin access token. Separate from FORM_TOKEN_SECRET on purpose: those two sign
# things with very different consequences.
ADMIN_JWT_SECRET=replace-me-with-32-random-bytes

# Peppers the refresh-token digest, so the stored column cannot be replayed on its own.
ADMIN_REFRESH_SECRET=replace-me-with-32-random-bytes
