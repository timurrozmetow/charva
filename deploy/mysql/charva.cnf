# MySQL 8.4 на машине с 956 МБ памяти.
#
# Кладётся в /etc/mysql/mysql.conf.d/99-charva.cnf — после файла дистрибутива, поэтому
# перекрывает его.
#
# Половина строк здесь — про корректность и обязана совпадать с тем, против чего писались
# миграции и тесты. Вторая половина — про то, чтобы всё это поместилось в память, которой на
# этой машине почти нет.

[mysqld]

# --------------------------------------------------------------------------------------
# Корректность. Эти четыре строки не про производительность и меняться не должны.
# --------------------------------------------------------------------------------------

# `STRICT_TRANS_TABLES` — причина, по которой слишком длинная строка не обрезается молча, а
# `ONLY_FULL_GROUP_BY` ловит агрегат без группировки. Тесты доказывают, что правила держит
# база, а не приложение; с другим `sql_mode` они доказывают что-то другое.
sql_mode = STRICT_TRANS_TABLES,ONLY_FULL_GROUP_BY,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Не «SYSTEM». Дата вылета хранится в UTC, отсчёт на трёх сайтах считается от неё, а
# `parseSqlDate` дописывает `Z` к строке, пришедшей из MySQL. Часовой пояс, унаследованный от
# системы, однажды сменится при переносе машины — и сдвинет вылет, а не сломает запрос.
default-time-zone = '+00:00'

# Только петля. Наружу базу не пускаем ни правилом ufw, ни этим — двумя способами сразу,
# потому что один из них когда-нибудь окажется выключен.
bind-address = 127.0.0.1

# --------------------------------------------------------------------------------------
# Память. Настройки по умолчанию рассчитаны на машину покрупнее этой.
# --------------------------------------------------------------------------------------

# Самая крупная экономия здесь, около 200 МБ. `performance_schema` — инструмент профилирования
# для базы, которую профилируют; эту не профилирует никто, а её постоянная стоимость на 956 МБ
# сопоставима со всем остальным сервером.
performance_schema = OFF

# Весь контент — несколько сотен строк и несколько десятков таблиц. 128 МБ буфера — это вся
# база в памяти целиком, с запасом.
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
innodb_redo_log_capacity = 64M

# Без двойной буферизации: страницу, уже лежащую в буферном пуле, незачем держать ещё и в
# кеше файловой системы.
innodb_flush_method = O_DIRECT

# `DATABASE_POOL_SIZE=10`, инстанс один (D-7). Пятьдесят — это пятикратный запас; сто пятьдесят
# по умолчанию — это резерв буферов под соединения, которых никогда не будет.
max_connections = 50

table_open_cache = 400
tmp_table_size = 32M
max_heap_table_size = 32M
sort_buffer_size = 512K
join_buffer_size = 512K
read_buffer_size = 256K
read_rnd_buffer_size = 512K

# MyISAM здесь нет ни одной таблицы, но буфер выделяется всё равно.
key_buffer_size = 8M

# --------------------------------------------------------------------------------------
# Логи
# --------------------------------------------------------------------------------------
slow_query_log = ON
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1
